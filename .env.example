# SMTP (server-only — never use NEXT_PUBLIC_ for these)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Address shown as sender (often must match your SMTP account)
MAIL_FROM="DentCare Website <noreply@example.com>"

# Inbox that receives contact form submissions
CONTACT_TO_EMAIL=hello@example.com
